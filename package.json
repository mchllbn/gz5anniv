{
  "name": "anniversary-photobooth",
  "version": "1.0.0",
  "description": "Golden Z-5 Security & Investigation Agency — 20th Anniversary photobooth",
  "main": "electron/main.js",
  "author": "Event Ops",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "start": "npm run dev",
    "web": "vite",
    "build:renderer": "vite build",
    "generate:template": "node scripts/generate-template.mjs",
    "postinstall": "node scripts/ensure-dirs.mjs && node scripts/generate-template.mjs",
    "prestart": "node scripts/ensure-dirs.mjs",
    "build": "npm run generate:template && npm run build:renderer && electron-builder --win",
    "pack": "npm run generate:template && npm run build:renderer && electron-builder --win --dir"
  },
  "build": {
    "appId": "com.goldenz5.anniversary-photobooth",
    "productName": "Golden Z-5 Photobooth",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "config.json",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "config.json",
        "to": "config.json"
      },
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@fontsource/cinzel": "^5.2.5",
    "@fontsource-variable/cormorant-garamond": "^5.2.5",
    "@fontsource-variable/source-sans-3": "^5.2.5",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "pngjs": "^7.0.0",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
